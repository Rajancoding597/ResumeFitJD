{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mvn -Dmaven.test.skip=true clean package"
  },
  "deploy": {
    "startCommand": "java -jar target/resume-tailor-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
